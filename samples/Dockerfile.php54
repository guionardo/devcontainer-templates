# STEP 1: Use Debian Jessie
FROM debian:jessie-slim

# Jessie is archived; avoid the obsolete jessie/updates endpoint, which redirects to HTTPS.
RUN rm -f /etc/apt/sources.list && \
    echo "deb http://archive.debian.org/debian jessie main contrib non-free" > /etc/apt/sources.list && \
    echo "deb http://archive.debian.org/debian-security jessie/updates main" >> /etc/apt/sources.list && \
    echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/100disablecheckvaliduntil

# Install development and compilation dependencies
RUN apt-get update && apt-get install -y --force-yes \
    apache2 \
    apache2-dev \
    build-essential \
    libxml2-dev \
    libcurl4-openssl-dev \
    libssl-dev \
    autoconf \
    wget \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /usr/local/src
RUN wget --no-check-certificate https://www.php.net/distributions/php-5.4.45.tar.gz && \
    tar -zxf php-5.4.45.tar.gz

WORKDIR /usr/local/src/php-5.4.45
RUN ./configure \
    --with-apxs2=/usr/bin/apxs2 \
    --with-mysql=mysqlnd \
    --with-mysqli=mysqlnd \
    --with-pdo-mysql=mysqlnd \
    --enable-mbstring \
    --with-curl \
    && make && make install

# Xdebug 2.4.1 is the final compatible branch for PHP 5.4.
WORKDIR /usr/local/src
COPY xdebug-2.4.1.tgz /usr/local/src/xdebug-2.4.1.tgz
RUN tar -zxf xdebug-2.4.1.tgz && \
    cd xdebug-2.4.1 && \
    phpize && ./configure --enable-xdebug && make && make install && \
    printf '\nzend_extension=%s/xdebug.so\nxdebug.remote_enable=1\nxdebug.remote_autostart=0\nxdebug.remote_connect_back=0\nxdebug.remote_host=host.docker.internal\nxdebug.remote_port=9000\n' "$(php-config --extension-dir)" >> /usr/local/lib/php.ini

# PHP 5.4's non-thread-safe Apache module requires Apache's prefork MPM.
RUN a2dismod mpm_event && a2enmod mpm_prefork && \
    echo "AddType application/x-httpd-php .php" >> /etc/apache2/apache2.conf

ENV APACHE_RUN_USER=www-data \
    APACHE_RUN_GROUP=www-data \
    APACHE_LOG_DIR=/var/log/apache2 \
    APACHE_LOCK_DIR=/var/lock/apache2 \
    APACHE_PID_FILE=/var/run/apache2/apache2.pid

# Debian Jessie ships an old Apache config that needs explicit runtime paths.
RUN mkdir -p /var/lock/apache2 /var/run/apache2 /var/log/apache2 && \
    sed -i 's|Mutex file:${APACHE_LOCK_DIR}|Mutex file:/var/lock/apache2|' /etc/apache2/apache2.conf

WORKDIR /var/www/html
EXPOSE 80
CMD ["sh", "-c", "rm -f \"$APACHE_PID_FILE\" && exec /usr/sbin/apache2 -D FOREGROUND"]
